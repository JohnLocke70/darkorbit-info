[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]750 000[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]12 000[/COLOR][/CENTER][/TD][/TR]
