[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]8[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]7[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]1 650[/COLOR][/CENTER][/TD][/TR]
[TR][TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]Mixte renforcée[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]5[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]10[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]1 875[/COLOR][/CENTER][/TD][/TR]
