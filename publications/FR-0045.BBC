[TR][TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]Bonus PvE d'ensemble[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]Aucun[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]+25 %[/COLOR][/CENTER][/TD][/TR]
