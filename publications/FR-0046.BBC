[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]220[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]205[/COLOR][/CENTER][/TD][/TR]
[TR][TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]Orientation[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]Principalement PvP[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]PvE (NPC)[/COLOR][/CENTER][/TD][/TR]
