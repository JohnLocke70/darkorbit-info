[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]+7 %[/COLOR][/CENTER][/TD]
[TD="bgcolor: #25323E"][CENTER][COLOR=#FFFFFF]235,4[/COLOR][/CENTER][/TD]
